# fixtures/ should ever be committed.
*.tfplan
tfplan
*.tfstate
*.tfstate.*
.terraform/

# --- macOS ---
.DS_Store
._*

# --- IDEs / editors ---
.idea/
.vscode/
*.swp
*~

# --- Logs ---
*.log
